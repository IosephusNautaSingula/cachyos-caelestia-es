+    // The locale's long date format without the year, e.g. "Monday, March 1" (en_US),
+    // "lunes, 1 de marzo" (es_ES), "Montag, 1. März" (de_DE)
+    function longDateNoYear(date: date): string {
+        const fmt = Qt.locale().dateFormat(Locale.LongFormat)
+            .replace(/[\s,.]*(?:'[^']*'\s*)?y+[\s.]*$/, "")
+            .replace(/^y+(?:'[^']*'|[^dMy\s'])*\s*/, "");
+        return Qt.locale().toString(date, fmt);
+    }
+
+    // Abbreviated month and day in the locale's day/month order, e.g. "Mar 2" (en_US), "2 mar" (es_ES)
+    function shortDayMonth(date: date): string {
+        const fmt = Qt.locale().dateFormat(Locale.ShortFormat);
+        return Qt.locale().toString(date, fmt.indexOf("d") < fmt.indexOf("M") ? "d MMM" : "MMM d");
+    }
+
+    // A number with the locale's decimal separator, keeping the same digits as String(value)
+    function number(value: real): string {
+        return Qt.locale().toString(value, "g", 15);
