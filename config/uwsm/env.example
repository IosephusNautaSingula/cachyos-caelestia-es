# Entorno de la sesión gráfica con UWSM. Ruta: ~/.config/uwsm/env (lo leen todas las sesiones de UWSM).

# Tema Qt
export QT_QPA_PLATFORMTHEME='qtengine'
export QT_WAYLAND_DISABLE_WINDOWDECORATION='1'
export QT_AUTO_SCREEN_SCALE_FACTOR='1'

# PATH sin duplicados: el entorno importado del shell de inicio de sesión ya puede traer ~/.local/bin;
# se quitan antes de anteponerlos
_p=$(printf '%s' ":$PATH:" | sed -e ':a' -e "s|:$HOME/.local/bin:|:|" -e "s|:$HOME/.local/share/mise/shims:|:|" -e 'ta' -e 's/^://' -e 's/:$//')
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims${_p:+:$_p}"; unset _p

# Agente SSH (opcional): si su gestor de contraseñas ofrece un agente SSH, ponga aquí la ruta de su socket
# export SSH_AUTH_SOCK="$HOME/.ruta-del-socket-del-agente.sock"

export EDITOR=nvim VISUAL=nvim   # visudo, sudoedit, systemctl edit

# Directorios XDG de usuario en español (copiados de ~/.config/user-dirs.dirs, para las apps que no lo leen)
export XDG_DESKTOP_DIR="$HOME/Escritorio"
export XDG_DOWNLOAD_DIR="$HOME/Descargas"
export XDG_TEMPLATES_DIR="$HOME/Plantillas"
export XDG_PUBLICSHARE_DIR="$HOME/Público"
export XDG_DOCUMENTS_DIR="$HOME/Documentos"
export XDG_MUSIC_DIR="$HOME/Música"
export XDG_PICTURES_DIR="$HOME/Imágenes"
export XDG_VIDEOS_DIR="$HOME/Vídeos"

# AutoFirma con el almacén NSS de Zen o Firefox (el fichero lo genera estacion-autofirma-nss)
export AFIRMA_NSS_PROFILES_INI="${XDG_CONFIG_HOME:-$HOME/.config}/estacion/afirma-profiles.ini"
