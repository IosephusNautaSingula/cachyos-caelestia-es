# SPDX-License-Identifier: GPL-3.0-or-later
# Al enchufar el cargador (tipo Mains, online=1): intentar la copia si hoy aún no hay copia correcta.
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="1", ACTION=="change", RUN+="/usr/bin/systemctl --no-block start estacion-copia-cargador.service"
