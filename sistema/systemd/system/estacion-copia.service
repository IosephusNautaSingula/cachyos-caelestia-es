[Unit]
Description=Estación: copia de seguridad en el NAS (restic)
After=network-online.target
Wants=network-online.target
ConditionACPower=true
OnFailure=estacion-copia-aviso@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/estacion-copia copia
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=6h
