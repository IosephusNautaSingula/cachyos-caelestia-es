+
+    // Retry focusing the app shortly after invoking its default action, in case it creates or maps its window late
+    // (e.g. with misc:focus_on_activate disabled the app cannot raise itself). The notification is closed then.
+    readonly property Timer focusRetryTimer: Timer {
+        interval: 700
+        onTriggered: {
+            notif.focusApp(false);
+            notif.close();
+        }
+    }
+
+    // Called when the notification (popup or sidebar entry) is clicked. Returns true if something was done:
+    // 1. The notification is still alive and has a "default" action: invoke it (e.g. a chat app opens the
+    //    conversation) and focus the app's window.
+    // 2. It carries an "x-caelestia-log" hint: open that journal unit or log file in the terminal.
+    // 3. Otherwise focus the app's window (by desktop entry, app name or the .desktop's StartupWMClass), or launch
+    //    the app from its .desktop file if it has no window (e.g. it lives in the tray or was closed).
+    function activate(): bool {
+        if (notification && defaultAction?.invoke) {
+            defaultAction.invoke();
+            popup = false;
+            focusApp(false);
+            focusRetryTimer.start();
+            return true;
+        }
+
+        // Any app can send hints, so only two shapes are accepted: "journal:<unit>" with a validated unit name, or an
+        // absolute path inside the user's state directory without "..". Arguments are passed as a list, never
+        // through a shell.
+        const unit = /^journal:([A-Za-z0-9@._-]+)$/.exec(logTarget)?.[1];
+        const stateDir = (Quickshell.env("XDG_STATE_HOME") || `${Quickshell.env("HOME")}/.local/state`) + "/";
+        const title = summary || appName;
+        if (unit) {
+            Quickshell.execDetached([...GlobalConfig.general.apps.terminal, "-T", title, "journalctl", "-e", "-n", "300", "-u", unit]);
+            close();
+            return true;
+        }
+        if (stateDir.startsWith("/") && logTarget.startsWith(stateDir) && !logTarget.includes("..")) {
+            Quickshell.execDetached([...GlobalConfig.general.apps.terminal, "-T", title, "less", "+G", logTarget]);
+            close();
+            return true;
+        }
+
+        return focusApp(true);
+    }
+
+    // Focuses the app's window (matching desktop entry, app name, .desktop id or StartupWMClass against the window
+    // class), even on another workspace. With no window and launch = true, starts the app from its .desktop file.
+    function focusApp(launch: bool): bool {
+        // Only installed .desktop files: the desktop entry must be a plain id (no "/" or ".."), otherwise it is ignored
+        const de = /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(desktopEntry) && !desktopEntry.includes("..") ? desktopEntry : "";
+        const entry = (de ? DesktopEntries.byId(de) : null) ?? DesktopEntries.heuristicLookup(de || appName);
+        const keys = [de, appName, entry?.id, entry?.startupClass].filter(k => !!k).map(k => k.toLowerCase());
+        if (keys.length === 0)
+            return false;
+
+        const win = Hypr.toplevels.values.find(t => {
+            const cls = (t.lastIpcObject?.class ?? "").toLowerCase();
+            const ini = (t.lastIpcObject?.initialClass ?? "").toLowerCase();
+            return keys.includes(cls) || keys.includes(ini);
+        });
+        if (win) {
+            Hypr.dispatch(Hypr.usingLua ? `hl.dsp.focus({ window = "address:0x${win.address}" })` : `focuswindow address:0x${win.address}`);
+            return true;
+        }
+        if (launch && entry) {
+            entry.execute();
+            return true;
+        }
+        return false;
+    }
